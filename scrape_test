def test_solutions():
    """Run tests for each challenge"""
    print("Testing your solutions...")
    
    # Challenge 1: Square Numbers
    # Transform each number in the list to its square
    assert square_numbers([1, 2, 3, 4, 5]) == [1, 4, 9, 16, 25], "Challenge 1 Failed"
    
    # Challenge 2: Filter Positive
    # Keep only the positive numbers from the input list
    assert filter_positive([-1, 0, 1, 2, -3, 4]) == [1, 2, 4], "Challenge 2 Failed"
    
    # Challenge 3: String Length
    # Create a list of lengths for each input string
    assert string_lengths(['python', 'lambda', 'function']) == [6, 6, 8], "Challenge 3 Failed"
    
    # Challenge 4: Sum of Numbers
    # Calculate the total sum of all numbers in the list
    assert sum_numbers([1, 2, 3, 4, 5]) == 15, "Challenge 4 Failed"
    
    # Challenge 5: Find Max
    # Determine the maximum value in the list
    assert find_max([10, 5, 8, 20, 3]) == 20, "Challenge 5 Failed"
    
    # Challenge 6: Uppercase Words
    # Convert each word to uppercase
    assert uppercase_words(['hello', 'world', 'python']) == ['HELLO', 'WORLD', 'PYTHON'], "Challenge 6 Failed"
    
    # Challenge 7: Filter Long Words
    # Select words that are longer than 4 characters
    assert filter_long_words(['cat', 'python', 'code', 'programming']) == ['python', 'programming'], "Challenge 7 Failed"
    
    # Challenge 8: Celsius to Fahrenheit
    # Convert each Celsius temperature to Fahrenheit
    assert celsius_to_fahrenheit([0, 10, 20, 30]) == [32.0, 50.0, 68.0, 86.0], "Challenge 8 Failed"
    
    # Challenge 9: Even Number Squares
    # Square only the even numbers in the list
    assert even_number_squares([1, 2, 3, 4, 5, 6]) == [4, 16, 36], "Challenge 9 Failed"
    
    # Challenge 10: Product of Numbers
    # Calculate the product of all numbers in the list
    assert product_numbers([1, 2, 3, 4, 5]) == 120, "Challenge 10 Failed"
    
    # Challenge 11: Palindrome Filter
    # Keep only the words that read the same backward and forward
    assert filter_palindromes(['radar', 'hello', 'level', 'python']) == ['radar', 'level'], "Challenge 11 Failed"
    
    # Challenge 12: Name Formatter
    # Format names to show first initial and last name
    assert format_names(['John Doe', 'Jane Smith']) == ['J. Doe', 'J. Smith'], "Challenge 12 Failed"
    
    # Challenge 13: Grade Classifier
    # Convert numeric scores to letter grades
    assert classify_grades([45, 75, 85, 95]) == ['F', 'C', 'B', 'A'], "Challenge 13 Failed"
    
    # Challenge 14: Flatten List
    # Convert a list of lists into a single flat list
    assert flatten_list([[1, 2], [3, 4], [5, 6]]) == [1, 2, 3, 4, 5, 6], "Challenge 14 Failed"
    
    # Challenge 15: Count Occurrences
    # Count how many times a specific element appears in the list
    assert count_occurrences([1, 2, 2, 3, 2, 4, 2], 2) == 4, "Challenge 15 Failed"
    
    print("All challenges passed! Great job!")


